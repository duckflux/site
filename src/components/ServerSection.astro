---
import { Code } from 'astro:components';

const serverCmd = `# Start the dev server
quack server --trace-dir ./traces --workflow-dir ./workflows

# Open http://localhost:3000`;
---

<section id="server" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="reveal text-center mb-12">
      <p class="font-mono text-duck-500 text-sm font-semibold mb-4 uppercase tracking-widest">Built-in Dev Server</p>
      <h2 class="section-heading mb-4">Observe your <span class="gradient-text">Workflows</span></h2>
      <p class="section-subheading max-w-2xl mx-auto">
        A GitHub Actions-style web UI for executing, tracing, and debugging workflows locally.
        No extra setup — it's built into the CLI.
      </p>
    </div>

    <!-- Feature pills -->
    <div class="reveal flex flex-wrap gap-2 justify-center mb-10">
      {['Real-time trace', 'Execute from UI', 'Dark/Light mode', 'Step-by-step inspection', 'SSE live updates', 'Zero config'].map(tag => (
        <span class="px-3 py-1 rounded-md bg-surface border border-surface-border text-white/50 text-xs font-mono">
          {tag}
        </span>
      ))}
    </div>

    <div class="grid lg:grid-cols-2 gap-10 items-center">

      <!-- Left: screenshot in browser chrome -->
      <div class="reveal">
        <div class="server-preview-wrapper">
          <div class="server-preview-chrome">
            <div class="flex gap-1.5 items-center">
              <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
            </div>
            <div class="server-preview-url">
              <span class="text-white/30">http://</span>
              <span class="text-white/60">localhost:3000</span>
            </div>
          </div>
          <img src="/server-detail.png" alt="duckflux web server — workflow detail with execution history" class="server-preview-img" loading="lazy" />
        </div>
      </div>

      <!-- Right: description + code -->
      <div class="reveal delay-200 flex flex-col gap-6">
        <h3 class="font-mono font-bold text-white text-xl">
          Run <span class="text-duck-500">quack server</span> and go.
        </h3>
        <p class="text-white/55 leading-relaxed">
          The server scans your workflow directory, watches trace files, and pushes live updates to the browser.
          Execute workflows directly from the UI with auto-generated input forms based on your workflow's <code class="text-duck-500 bg-surface px-1.5 py-0.5 rounded text-sm">inputs</code> schema.
        </p>

        <div class="code-block rounded-xl overflow-hidden border border-surface-border">
          <Code code={serverCmd} lang="bash" theme="one-dark-pro" />
        </div>

        <a href="https://docs.duckflux.openvibes.tech/tooling/web-server-ui/"
           class="inline-flex items-center gap-2 text-duck-500 hover:text-duck-400 font-mono text-sm transition-colors w-fit">
          Learn more about the server UI
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .server-preview-wrapper {
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 215, 0, 0.04);
  }

  .server-preview-chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    background: #13131f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .server-preview-url {
    flex: 1;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    text-align: center;
  }

  .server-preview-img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
