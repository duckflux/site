---
import { Code } from 'astro:components';

const helloWorld = `# hello-world.duck.yaml
name: hello-world

participants:
  greet:
    type: exec
    command: echo "Hello from duckflux! 🦆"

steps:
  - run: greet`;

---

<section class="relative min-h-screen flex flex-col justify-center overflow-hidden pt-16">

  <!-- Background glow orbs -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-duck-500/5 blur-3xl animate-pulse-glow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 rounded-full bg-blue-500/5 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-duck-500/3 blur-3xl"></div>
  </div>

  <!-- Floating duck particles -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none" aria-hidden="true">
    {[
      { x: '8%',  y: '20%', delay: '0s',    dur: '8s',  opacity: '0.07', size: 20 },
      { x: '88%', y: '15%', delay: '1.2s',  dur: '10s', opacity: '0.05', size: 16 },
      { x: '75%', y: '70%', delay: '2.5s',  dur: '7s',  opacity: '0.06', size: 24 },
      { x: '15%', y: '75%', delay: '0.8s',  dur: '9s',  opacity: '0.05', size: 18 },
      { x: '50%', y: '85%', delay: '3.1s',  dur: '11s', opacity: '0.04', size: 14 },
      { x: '92%', y: '50%', delay: '1.7s',  dur: '8.5s',opacity: '0.06', size: 22 },
    ].map(p => (
      <div
        class="absolute animate-float"
        style={`left: ${p.x}; top: ${p.y}; opacity: ${p.opacity}; animation-delay: ${p.delay}; animation-duration: ${p.dur};`}
      >
        <img src="/duckflow.png" width={p.size * 2} height={p.size * 2} alt="" style={`width: ${p.size * 2}px; height: ${p.size * 2}px; object-fit: contain;`} />
      </div>
    ))}
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 overflow-hidden">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-24 items-center">

      <!-- Left column: text content -->
      <div class="flex flex-col gap-8 min-w-0 overflow-hidden">

        <!-- Main heading -->
        <div class="reveal">
          <h1 class="font-mono font-bold text-4xl sm:text-5xl lg:text-5xl leading-[1.1] tracking-tight">
            <span class="text-white">Declarative</span>
            <br />
            <span class="text-white">Workflow DSL</span>
            <br />
            <span class="text-white/70">for <span id="hero-typewriter" class="gradient-text typing-cursor"></span></span>
          </h1>
        </div>

        <!-- Subheading -->
        <p class="reveal delay-100 text-lg text-white/60 leading-relaxed max-w-lg">
          Define workflow pipelines in <span class="text-duck-500 font-semibold">YAML</span>.
          Execute your flow anywhere.
          Ideal for <span class="text-white font-semibold">deterministic orchestration</span>.
        </p>

        <!-- CTA buttons -->
        <div class="reveal delay-200 flex flex-wrap gap-4">
          <a href="https://docs.duckflux.openvibes.tech/getting-started/your-first-workflow/" class="btn-primary">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            Read the Docs
          </a>
          <a href="https://github.com/duckflux/spec" target="_blank" rel="noopener" class="btn-outline">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
            </svg>
            Star on GitHub
          </a>
        </div>

        <!-- Duck mascot on mobile -->
        <div class="reveal delay-500 flex lg:hidden justify-center pt-4">
          <img src="/duckflow.png" width="96" height="96" alt="duckflux logo" class="animate-float object-contain duck-glow" />
        </div>
      </div>

      <!-- Right column: tool showcase carousel -->
      <div class="reveal-right delay-200 relative">

        <!-- Duck mascot on desktop (floating above carousel) -->
        <div class="hidden lg:flex absolute -top-14 right-8 z-10 justify-end">
          <img src="/duckflow.png" width="88" height="88" alt="duckflux logo" class="animate-float object-contain duck-glow" />
        </div>

        <!-- Carousel container -->
        <div class="carousel-wrapper shadow-duck glow-border">
          <div class="carousel-stage">

          <!-- Panel 0: Web Server UI -->
          <div class="carousel-panel active" data-panel="0">
            <div class="carousel-chrome">
              <div class="flex gap-1.5">
                <div class="code-dot bg-red-500/70"></div>
                <div class="code-dot bg-yellow-500/70"></div>
                <div class="code-dot bg-green-500/70"></div>
              </div>
              <span class="carousel-label">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block"></span>
                observe &amp; execute
              </span>
            </div>
            <div class="carousel-content">
              <img src="/server-trace.png" alt="duckflux web server — trace viewer" class="carousel-img" loading="eager" />
            </div>
          </div>

          <!-- Panel 1: Code -->
          <div class="carousel-panel" data-panel="1">
            <div class="carousel-chrome">
              <div class="flex gap-1.5">
                <div class="code-dot bg-red-500/70"></div>
                <div class="code-dot bg-yellow-500/70"></div>
                <div class="code-dot bg-green-500/70"></div>
              </div>
              <span class="ml-2 text-xs font-mono text-white/40">hello-world.duck.yaml</span>
              <div class="ml-auto flex items-center gap-1">
                <a id="hero-open-editor-link"
                   href="https://editor.duckflux.openvibes.tech"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="p-1.5 rounded text-white/40 hover:text-duck-500 hover:bg-surface-hover transition-colors"
                   aria-label="Open in editor"
                   title="Open in editor">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
                <button class="copy-btn p-1.5 rounded text-white/40 hover:text-duck-500 hover:bg-surface-hover transition-colors"
                        aria-label="Copy code">
                  <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                  <svg class="w-4 h-4 check-icon hidden text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </button>
              </div>
              <span class="carousel-label ml-0">
                <span class="w-1.5 h-1.5 rounded-full bg-duck-500 inline-block"></span>
                define in YAML
              </span>
            </div>
            <div class="carousel-content carousel-code-content">
              <div id="code-hello" class="code-pane">
                <Code code={helloWorld} lang="yaml" theme="one-dark-pro" />
              </div>
            </div>
          </div>

          <!-- Panel 2: Editor -->
          <div class="carousel-panel" data-panel="2">
            <div class="carousel-chrome">
              <div class="flex gap-1.5">
                <div class="code-dot bg-red-500/70"></div>
                <div class="code-dot bg-yellow-500/70"></div>
                <div class="code-dot bg-green-500/70"></div>
              </div>
              <span class="carousel-label">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-400 inline-block"></span>
                visualize &amp; debug
              </span>
            </div>
            <div class="carousel-content">
              <img src="/editor-preview.png" alt="duckflux visual editor" class="carousel-img" loading="lazy" />
            </div>
          </div>

          </div><!-- end carousel-stage -->

          <!-- Carousel dots -->
          <div class="carousel-dots">
            <button class="carousel-dot active" data-goto="0" aria-label="Web Server">Server</button>
            <button class="carousel-dot" data-goto="1" aria-label="Code">Code</button>
            <button class="carousel-dot" data-goto="2" aria-label="Editor">Editor</button>
          </div>
        </div>

      </div>
    </div>

    <!-- Install command -->
    <div class="reveal delay-300 mt-12 flex justify-center">
      <div class="install-bar group relative flex items-center gap-3 px-5 py-3 rounded-xl border border-white/10 bg-surface/60 backdrop-blur-sm hover:border-duck-500/40 transition-colors">
        <span class="text-white/40 text-sm font-mono">$</span>
        <code class="text-sm font-mono text-white/80 select-all">curl -fsSL https://duckflux.github.io/apt-repo/install.sh | bash</code>
        <button class="install-copy-btn p-1.5 rounded text-white/30 hover:text-duck-500 hover:bg-surface-hover transition-colors" aria-label="Copy install command">
          <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <svg class="w-4 h-4 check-icon hidden text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/25 text-xs font-mono animate-bounce">
      <span>scroll</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .carousel-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #12122a;
    border: 1px solid rgba(255,255,255,0.07);
  }

  /* Panels stack via absolute positioning so the wrapper keeps a stable size */
  .carousel-stage {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .carousel-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    display: flex;
    flex-direction: column;
  }
  .carousel-panel.active {
    opacity: 1;
    pointer-events: auto;
  }

  .carousel-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: #0f0f1e;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .carousel-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.7rem;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .carousel-content {
    flex: 1;
    overflow: hidden;
    display: flex;
    align-items: stretch;
  }
  .carousel-content img.carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    display: block;
  }
  .carousel-code-content {
    flex-direction: column;
  }
  .carousel-code-content .code-pane {
    flex: 1;
  }

  .carousel-dots {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    background: #0a0a18;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .carousel-dot {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.7rem;
    color: rgba(255,255,255,0.35);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .carousel-dot:hover {
    color: rgba(255,255,255,0.6);
    background: rgba(255,255,255,0.04);
  }
  .carousel-dot.active {
    color: #F5C518;
    border-color: rgba(245,197,24,0.3);
    background: rgba(245,197,24,0.08);
  }

  @media (max-width: 768px) {
    .carousel-stage {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  // Hero typewriter
  (function() {
    const el = document.getElementById('hero-typewriter');
    if (!el) return;
    const phrases = ['AI Agents', 'Automations', 'CI/CD', 'Orchestration', 'Everything'];
    let phraseIdx = 0;
    let charIdx = 0;
    let deleting = false;
    let pause = false;

    function tick() {
      const current = phrases[phraseIdx];
      if (pause) {
        pause = false;
        setTimeout(tick, 1400);
        return;
      }
      if (!deleting) {
        el.textContent = current.slice(0, charIdx + 1);
        charIdx++;
        if (charIdx === current.length) {
          deleting = true;
          pause = true;
          setTimeout(tick, 30);
          return;
        }
        setTimeout(tick, 60);
      } else {
        el.textContent = current.slice(0, charIdx - 1);
        charIdx--;
        if (charIdx === 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          setTimeout(tick, 300);
          return;
        }
        setTimeout(tick, 35);
      }
    }
    setTimeout(tick, 800);
  })();

  // ─── Carousel ───
  const panels = document.querySelectorAll<HTMLElement>('.carousel-panel');
  const dots   = document.querySelectorAll<HTMLElement>('.carousel-dot');
  let currentPanel = 0;
  let autoTimer: ReturnType<typeof setInterval> | null = null;

  function showPanel(idx: number) {
    panels.forEach(p => p.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    panels[idx]?.classList.add('active');
    dots[idx]?.classList.add('active');
    currentPanel = idx;
  }

  function startAuto() {
    stopAuto();
    autoTimer = setInterval(() => {
      showPanel((currentPanel + 1) % panels.length);
    }, 5000);
  }

  function stopAuto() {
    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const idx = parseInt(dot.dataset.goto ?? '0', 10);
      showPanel(idx);
      startAuto(); // restart timer on manual click
    });
  });

  startAuto();

  // Update editor link with the code content
  const editorLink = document.getElementById('hero-open-editor-link') as HTMLAnchorElement | null;
  if (editorLink) {
    const yaml = document.getElementById('code-hello')?.textContent?.trim() ?? '';
    const encoded = btoa(unescape(encodeURIComponent(yaml)));
    editorLink.href = `https://editor.duckflux.openvibes.tech/#code=${encoded}`;
  }

  // Install bar copy button
  document.querySelectorAll('.install-copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText('curl -fsSL https://duckflux.github.io/apt-repo/install.sh | bash').then(() => {
        const copyIcon  = btn.querySelector('.copy-icon')!;
        const checkIcon = btn.querySelector('.check-icon')!;
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      });
    });
  });

  // Copy button
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = document.getElementById('code-hello')?.textContent ?? '';
      navigator.clipboard.writeText(text.trim()).then(() => {
        const copyIcon  = btn.querySelector('.copy-icon')!;
        const checkIcon = btn.querySelector('.check-icon')!;
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      });
    });
  });
</script>
