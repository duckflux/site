---
import { Code } from 'astro:components';

const bunInstall = `# Install with Bun
bun add -g duckflux

# Run a workflow
duck run ./my-workflow.duck.yaml

# Use as library in your Bun app
import { run } from 'duckflux';

const result = await run('./pipeline.duck.yaml', {
  inputs: { repo: 'https://github.com/org/repo' }
});`;
---

<section id="runtimes" class="py-24 relative">
  <!-- Top border accent -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-surface-border to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="reveal text-center mb-16">
      <h2 class="section-heading mb-4">Same YAML, any <span class="gradient-text">Runtime</span></h2>
      <p class="section-subheading max-w-2xl mx-auto">
        One workflow definition runs anywhere. Use the JS/TS runtime to integrate with your Node/Bun ecosystem.
      </p>
    </div>

    <div class="grid lg:grid-cols-1 gap-6 max-w-2xl mx-auto">

      <!-- JS/TS Runtime -->
      <div class="reveal delay-200 section-card rounded-xl border border-surface-border overflow-hidden hover:border-duck-700/50 transition-all duration-300">
        <div class="p-6 border-b border-surface-border">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <!-- Bun logo area -->
              <div class="w-12 h-12 rounded-xl bg-duck-500/15 border border-duck-700/40 flex items-center justify-center text-2xl">
                🍞
              </div>
              <div>
                <h3 class="font-mono font-bold text-white text-lg">JS/TS (Bun)</h3>
                <p class="text-white/45 text-sm">Bun &amp; Node.js compatible</p>
              </div>
            </div>
            <div class="flex gap-2">
              <span class="px-2.5 py-1 rounded-full bg-duck-500/15 border border-duck-700/40 text-duck-500 text-xs font-mono">v0.1.0</span>
              <span class="px-2.5 py-1 rounded-full bg-yellow-500/15 border border-yellow-500/30 text-yellow-400 text-xs font-mono">beta</span>
            </div>
          </div>

        </div>

        <Code code={bunInstall} lang="bash" theme="one-dark-pro" />
      </div>
    </div>

    <!-- Quick start CTA -->
    <div class="reveal mt-10 text-center">
      <p class="text-white/40 text-sm font-mono mb-4">Not sure which to choose?</p>
      <a href="https://docs.duckflux.openvibes.tech/runner-cli/installation/" class="inline-flex items-center gap-2 text-duck-500 hover:text-duck-400 font-mono text-sm transition-colors">
        Read the runtime comparison guide
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>
  </div>
</section>
