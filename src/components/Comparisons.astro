---
type CellValue = string;

interface Tool {
  name: string;
  url: string;
  tagline: string;
}

interface Feature {
  label: string;
  duck: CellValue;
  argo: CellValue;
  gha: CellValue;
  n8n: CellValue;
  temporal: CellValue;
  airflow: CellValue;
}

const tools: Tool[] = [
  { name: 'duckflux',  url: '/',                                              tagline: 'YAML DSL' },
  { name: 'Argo',      url: 'https://argoproj.github.io/workflows/',          tagline: 'K8s CI/CD' },
  { name: 'GHA',       url: 'https://github.com/features/actions',            tagline: 'GitHub CI' },
  { name: 'n8n',       url: 'https://n8n.io',                                 tagline: 'Visual automation' },
  { name: 'Temporal',  url: 'https://temporal.io',                            tagline: 'Durable workflows' },
  { name: 'Airflow',   url: 'https://airflow.apache.org',                     tagline: 'Data pipelines' },
];

const features: Feature[] = [
  { label: 'Conditional loop', duck: 'native',   argo: 'template recursion', gha: 'unroll',     n8n: 'JS hack',       temporal: 'code',     airflow: 'impossible' },
  { label: 'Fixed loop',       duck: 'native',   argo: 'native',            gha: '✗',          n8n: 'JS hack',       temporal: 'code',     airflow: '✗' },
  { label: 'Parallelism',      duck: 'native',   argo: 'native',            gha: 'jobs',       n8n: 'visual',        temporal: 'goroutines',airflow: 'native' },
  { label: 'Conditional branch',duck: 'native',  argo: 'when',              gha: 'if',         n8n: 'IF node',       temporal: 'code',     airflow: 'BranchOp' },
  { label: 'Guard (when)',      duck: 'native',   argo: 'when',              gha: 'if per step', n8n: '✗',            temporal: 'code',     airflow: '✗' },
  { label: 'Events (emit/wait)',duck: 'native',   argo: '✗',                gha: '✗',          n8n: 'webhook',       temporal: 'signals',  airflow: 'sensors' },
  { label: 'Error handling',    duck: 'onError + retry', argo: 'retryStrategy', gha: 'continue-on-error', n8n: '✗', temporal: 'code',     airflow: '✗' },
  { label: 'Sub-workflows',    duck: 'native',   argo: 'template ref',      gha: 'reusable',   n8n: 'sub-workflow',  temporal: 'child wf', airflow: 'SubDagOp' },
  { label: 'Spec is readable', duck: '✓',        argo: 'partially',         gha: 'partially',  n8n: '✗ (JSON)',      temporal: '✗ (code)', airflow: '✗ (Python)' },
  { label: 'Inline participants',duck: 'native',  argo: '✗',                gha: '✗',          n8n: '✗',             temporal: '✗',        airflow: '✗' },
];

function cellStyle(v: string, isDuck: boolean) {
  if (isDuck) return 'text-duck-500 font-semibold';
  if (v === 'native' || v === '✓') return 'text-green-400';
  if (v === '✗' || v === 'impossible') return 'text-white/20';
  return 'text-white/45';
}

const cols: Array<keyof Omit<Feature, 'label'>> = ['duck', 'argo', 'gha', 'n8n', 'temporal', 'airflow'];
---

<section class="py-24 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-surface/20 to-transparent pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="reveal text-center mb-16">
      <h2 class="section-heading mb-4">How duckflux <span class="gradient-text">Compares</span></h2>
      <p class="section-subheading max-w-2xl mx-auto">
        The same workflow scenario across tools: a coder implements, a reviewer reviews,
        if not approved repeat up to 3 times, then deploy.
      </p>
    </div>

    <!-- Comparison table -->
    <div class="reveal overflow-x-auto">
      <table class="w-full border-collapse min-w-[800px]">
        <thead>
          <tr class="border-b border-surface-border">
            <th class="text-left py-4 px-4 text-white/40 font-mono text-xs font-medium w-44">Feature</th>
            {tools.map((tool, i) => (
              <th class={`py-4 px-3 text-center font-mono text-xs ${i === 0 ? 'text-duck-500' : 'text-white/60'}`}>
                <a href={tool.url} target={i > 0 ? '_blank' : undefined} rel="noopener"
                   class="flex flex-col items-center gap-1 hover:opacity-80 transition-opacity">
                  <span class={`font-bold ${i === 0 ? 'text-duck-500' : 'text-white/80'}`}>{tool.name}</span>
                  <span class="text-white/30 text-[10px] font-normal">{tool.tagline}</span>
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {features.map((feat, fi) => (
            <tr class={`border-b border-surface-border/50 transition-colors hover:bg-surface/30 ${fi % 2 === 0 ? '' : 'bg-surface/10'}`}>
              <td class="py-3 px-4">
                <span class="font-mono text-xs text-white/70 font-medium">{feat.label}</span>
              </td>
              {cols.map((col, ci) => (
                <td class={`py-3 px-3 text-center ${ci === 0 ? 'bg-duck-500/5' : ''}`}>
                  <span class={`text-xs font-mono ${cellStyle(feat[col], ci === 0)}`}>{feat[col]}</span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Disclaimer -->
    <p class="reveal mt-6 text-center text-white/25 text-xs font-mono">
      Based on publicly available documentation. Table reflects capabilities, not quality.
    </p>
  </div>
</section>
