---
const DOCS = 'https://docs.duckflux.openvibes.tech';

const features = [
  { icon: '🔁', title: 'Loops',              href: `${DOCS}/workflows/loops/` },
  { icon: '⚡', title: 'Parallel execution',  href: `${DOCS}/workflows/parallel/` },
  { icon: '🔀', title: 'Conditionals',        href: `${DOCS}/workflows/conditionals/` },
  { icon: '🛡️', title: 'Guards & retry',      href: `${DOCS}/workflows/error-handling/` },
  { icon: '📡', title: 'Events',              href: `${DOCS}/workflows/events/` },
  { icon: '📋', title: 'Input/Output schemas',href: `${DOCS}/workflows/inputs-outputs/` },
  { icon: '🪆', title: 'Nested workflows',    href: `${DOCS}/workflows/nested-workflows/` },
  { icon: '🔧', title: 'Error handling',      href: `${DOCS}/workflows/error-handling/` },
];
---

<section id="features" class="py-24 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-surface/30 to-transparent pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="reveal text-center mb-16">
      <h2 class="section-heading mb-4"><span class="gradient-text">Features</span></h2>
      <p class="section-subheading max-w-2xl mx-auto">
        From simple scripts to complex multi-agent pipelines — duckflux speaks
        the same YAML regardless of complexity.
      </p>
    </div>

    <!-- Feature cards grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {features.map(f => (
        <a
          href={f.href}
          target="_blank"
          rel="noopener"
          class="reveal feature-card group flex flex-col items-center gap-3 p-6 rounded-xl border border-surface-border bg-surface/30 hover:border-duck-700/50 hover:bg-surface-hover transition-all duration-200"
        >
          <span class="text-3xl">{f.icon}</span>
          <span class="font-mono font-semibold text-white/80 text-sm text-center group-hover:text-duck-500 transition-colors">
            {f.title}
          </span>
          <svg class="w-4 h-4 text-white/20 group-hover:text-duck-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      ))}
    </div>

  </div>
</section>
