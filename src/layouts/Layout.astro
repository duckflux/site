---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'duckflux — Declarative Workflow DSL for Multi-Agent Orchestration',
  description = 'Define complex AI agent pipelines in YAML. Let LLMs do creative work. Let duckflux handle the plumbing. Powered by Google CEL. JS/TS runtime for Bun and Node.js.',
  ogImage = '/og-image.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content="https://duckflux.dev" />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Canonical -->
    <link rel="canonical" href="https://duckflux.dev" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Title -->
    <title>{title}</title>

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Theme color -->
    <meta name="theme-color" content="#0a0a1a" />
  </head>

  <body>
    <slot />

    <!-- Swimming duck — left side, follows scroll -->
    <div id="swim-duck-rail" class="hidden lg:block" aria-hidden="true">
      <div id="swim-duck-wrapper">
        <img id="swim-duck-img" src="/duckflow.png" alt="" />
        <div class="swim-wake swim-w1"></div>
        <div class="swim-wake swim-w2"></div>
        <div class="swim-wake swim-w3"></div>
      </div>
    </div>

    <!-- Global Duck Scroll Navigator (right side) -->
    <div id="duck-scroll-nav" class="hidden lg:flex">
      <div id="duck-scroll-track">
        <div id="duck-scroll-progress"></div>
        <img id="duck-scroll-icon" src="/duckflow.png" alt="" aria-hidden="true" />
      </div>
    </div>

    <!-- Scroll reveal script -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal, .reveal-right').forEach((el) => {
        observer.observe(el);
      });

      // Duck scroll navigator (right side — progress bar)
      const duckScrollIcon = document.getElementById('duck-scroll-icon');
      const duckScrollProgress = document.getElementById('duck-scroll-progress');

      function updateDuckNav() {
        if (!duckScrollIcon || !duckScrollProgress) return;
        const scrollTop = window.scrollY;
        const docHeight = document.body.scrollHeight - window.innerHeight;
        const percent = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
        duckScrollIcon.style.top = percent + '%';
        duckScrollProgress.style.height = percent + '%';
      }

      window.addEventListener('scroll', updateDuckNav, { passive: true });
      updateDuckNav();

      // Swimming duck (left side — lerp-based smooth following)
      const swimWrapper = document.getElementById('swim-duck-wrapper') as HTMLElement | null;
      const swimRail = document.getElementById('swim-duck-rail') as HTMLElement | null;
      if (swimWrapper && swimRail) {
        let swimTarget = 0;
        let swimCurrent = 0;
        let swimRaf = 0;

        function swimCalc(): number {
          const scrollTop = window.scrollY;
          const docHeight = document.body.scrollHeight - window.innerHeight;
          return docHeight > 0 ? Math.max(0, Math.min(100, (scrollTop / docHeight) * 100)) : 0;
        }

        function swimTick() {
          const diff = swimTarget - swimCurrent;
          if (Math.abs(diff) < 0.05) {
            swimCurrent = swimTarget;
            swimRaf = 0;
          } else {
            swimCurrent += diff * 0.06;
            swimRaf = requestAnimationFrame(swimTick);
          }
          swimWrapper.style.top = swimCurrent + '%';
        }

        function onSwimScroll() {
          swimTarget = swimCalc();
          if (!swimRaf) swimRaf = requestAnimationFrame(swimTick);
        }

        window.addEventListener('scroll', onSwimScroll, { passive: true });
        swimCurrent = swimTarget = swimCalc();
        swimWrapper.style.top = swimCurrent + '%';
      }
    </script>
  </body>
</html>
